# Copy to .env and fill in a key. Never commit .env.

# --- LLM provider (pick one) ------------------------------------------------
YTCHAT_LLM_PROVIDER=groq

# Groq   - free, fast, no card:   https://console.groq.com/keys
YTCHAT_GROQ_API_KEY=gsk_your_key_here

# Gemini - free tier:             https://aistudio.google.com/apikey
# YTCHAT_LLM_PROVIDER=gemini
# YTCHAT_GOOGLE_API_KEY=your_key_here

# OpenRouter - free models:       https://openrouter.ai/keys
# YTCHAT_LLM_PROVIDER=openrouter
# YTCHAT_OPENROUTER_API_KEY=sk-or-your_key_here

# Ollama - fully local, no key, no limits (requires a running Ollama server)
# YTCHAT_LLM_PROVIDER=ollama

# --- Tuned defaults ---------------------------------------------------------
# These values are measured, not guessed. See docs/evaluation.md.
YTCHAT_RETRIEVER=dense
YTCHAT_MAX_CHARS=700
YTCHAT_MIN_SCORE=0.65

# NOTE: min_score is calibrated for max_chars=700 with bge-small-en-v1.5.
# Change either and recalibrate:  yt-chat eval calibrate <benchmark> -r dense
